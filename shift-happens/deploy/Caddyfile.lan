# Offline / LAN install with Caddy's internal certificate authority.
# Use this file instead of Caddyfile when the restaurant has no public domain.
# Set SITE_ADDRESS=https://chefuffle.local (or another local name) and install
# Caddy's root certificate on each tablet: http://<server>/ca  is not exposed,
# so copy /data/caddy/pki/authorities/local/root.crt from the caddy volume.
{$SITE_ADDRESS} {
	tls internal
	encode zstd gzip

	@backend path /api/* /socket.io/* /uploads/*
	reverse_proxy @backend api:4000

	reverse_proxy web:3010
}
