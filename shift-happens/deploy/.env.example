# ── Public address ───────────────────────────────────────────────────────────
# The address staff and tablets open. Caddy serves this name.
SITE_ADDRESS=chefuffle.online
PUBLIC_ORIGIN=https://chefuffle.online

# How the browser finds the API. "same-origin" uses the Caddy proxy above.
# Use an absolute URL only when the API is on a different host.
PUBLIC_API_URL=same-origin

# ── Database ─────────────────────────────────────────────────────────────────
# Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# ── Restaurant ───────────────────────────────────────────────────────────────
RESTAURANT_ID=11111111-1111-4111-8111-111111111111

# ── Optional integrations ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SMS_FROM=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=ops@shifthappens.local
STRIPE_SECRET_KEY=
REDIS_URL=
