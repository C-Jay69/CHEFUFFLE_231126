{
  "name": "@shift-happens/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/client.ts",
  "types": "./src/client.ts",
  "exports": {
    ".": "./src/client.ts"
  },
  "scripts": {
    "db:push": "prisma db push --skip-generate && prisma generate",
    "db:reset": "prisma db push --force-reset --skip-generate && prisma generate && tsx src/seed.ts",
    "seed": "tsx src/seed.ts",
    "generate": "prisma generate",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
