// SHIFT HAPPENS! relational schema
// Mirrors the DDL in the build prompt (section 4) with the additional
// reservations / staff / training tables required by the wired screens.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  general_manager
  floor_manager
  chef_expo
  line_cook
  server
  bartender
  host
}

enum TableCourseStage {
  seated
  starters
  mains_firing
  entree
  dessert
  check_dropped
  dirty_bussing
  ready
}

enum OrderStatus {
  open
  sent_to_kitchen
  preparing
  ready_at_pass
  served
  paid
  void
}

enum KdsStation {
  expo
  grill
  saute_fryer
  cold_larder
  pastry_dessert
  bar
}

enum StockTxReason {
  sale_deduction
  waste_spoilage
  purchase_receipt
  inventory_audit
  transfer
}

enum CallOutcome {
  reservation_booked
  faq_answered
  transferred_to_staff
  voicemail
  abandoned
}

model Restaurant {
  id                     String   @id @default(uuid()) @db.Uuid
  name                   String   @db.VarChar(255)
  address                String
  phone                  String   @db.VarChar(50)
  targetLaborPercentage  Decimal  @default(18.50) @map("target_labor_percentage") @db.Decimal(5, 2)
  floorPlanImageUrl      String?  @map("floor_plan_image_url")
  floorPlanImageType     String?  @map("floor_plan_image_type") @db.VarChar(80)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  tables           DiningTable[]
  menuCategories   MenuCategory[]
  menuItems        MenuItem[]
  ingredients      Ingredient[]
  orders           Order[]
  stockTransactions StockTransaction[]
  staff            Staff[]
  staffShifts      StaffShift[]
  knowledgeBase    KnowledgeBase[]
  callLogs         CallLog[]
  reservations     Reservation[]
  trainees         Trainee[]
  trainingModules  TrainingModule[]
  notifications    Notification[]
  briefingSignoffs BriefingSignoff[]

  @@map("restaurants")
}

model Staff {
  id         String   @id @default(uuid()) @db.Uuid
  restaurantId String @map("restaurant_id") @db.Uuid
  name       String   @db.VarChar(100)
  role       UserRole
  pin        String   @default("1234") @db.VarChar(10)
  hourlyRate Decimal  @default(18.00) @map("hourly_rate") @db.Decimal(10, 2)
  phone      String?  @db.VarChar(30)
  email      String?  @db.VarChar(120)
  address    String?  @db.VarChar(240)
  sin        String?  @db.VarChar(20)
  startDate  DateTime? @map("start_date") @db.Date
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]
  shifts     StaffShift[]
  tables     DiningTable[]
  reservations Reservation[]

  @@index([restaurantId, role])
  @@map("staff")
}

model DiningTable {
  id              String          @id @default(uuid()) @db.Uuid
  restaurantId    String          @map("restaurant_id") @db.Uuid
  tableNumber     String          @map("table_number") @db.VarChar(20)
  zone            String          @default("Main Dining Room") @db.VarChar(50)
  capacity        Int             @default(4)
  posX            Decimal         @default(0) @map("pos_x") @db.Decimal(8, 2)
  posY            Decimal         @default(0) @map("pos_y") @db.Decimal(8, 2)
  rotation        Int             @default(0)
  shape           String          @default("square") @db.VarChar(20)
  currentStage    TableCourseStage @default(ready) @map("current_stage")
  currentPartyName String?        @map("current_party_name") @db.VarChar(100)
  currentPartySize Int?           @map("current_party_size")
  seatedAt        DateTime?       @map("seated_at") @db.Timestamptz
  stageUpdatedAt  DateTime?       @map("stage_updated_at") @db.Timestamptz
  serverId        String?         @map("server_id") @db.Uuid
  isActive        Boolean         @default(true) @map("is_active")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  server     Staff?     @relation(fields: [serverId], references: [id], onDelete: SetNull)
  orders     Order[]
  reservations Reservation[]

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId, currentStage])
  @@map("dining_tables")
}

model MenuCategory {
  id            String @id @default(uuid()) @db.Uuid
  restaurantId  String @map("restaurant_id") @db.Uuid
  name          String @db.VarChar(100)
  displayOrder  Int    @default(0) @map("display_order")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id                   String     @id @default(uuid()) @db.Uuid
  restaurantId         String     @map("restaurant_id") @db.Uuid
  categoryId           String?    @map("category_id") @db.Uuid
  name                 String     @db.VarChar(255)
  description          String?
  price                Decimal    @db.Decimal(10, 2)
  station              KdsStation @default(grill)
  course               String     @default("main") @db.VarChar(20)
  targetPrepTimeSeconds Int       @default(840) @map("target_prep_time_seconds")
  imageUrlPos          String?    @map("image_url_pos")
  imageUrlMobile       String?    @map("image_url_mobile")
  cropPos              Json?      @map("crop_pos")
  cropMobile           Json?      @map("crop_mobile")
  tags                 String[]   @default([])
  is86ed               Boolean    @default(false) @map("is_86ed")
  eightySixReason      String?    @map("eighty_six_reason") @db.VarChar(300)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recipe     Recipe?
  orderItems OrderItem[]

  @@index([restaurantId, is86ed])
  @@map("menu_items")
}

model Ingredient {
  id             String   @id @default(uuid()) @db.Uuid
  restaurantId   String   @map("restaurant_id") @db.Uuid
  name           String   @db.VarChar(255)
  category       String   @db.VarChar(100)
  currentStock   Decimal  @default(0) @map("current_stock") @db.Decimal(12, 3)
  parLevel       Decimal  @map("par_level") @db.Decimal(12, 3)
  unit           String   @db.VarChar(20)
  unitCost       Decimal  @map("unit_cost") @db.Decimal(10, 2)
  supplierName   String?  @map("supplier_name") @db.VarChar(255)
  reorderTrigger Decimal  @map("reorder_trigger") @db.Decimal(12, 3)
  lastUpdated    DateTime @default(now()) @map("last_updated") @db.Timestamptz

  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  recipeIngredients RecipeIngredient[]
  stockTransactions StockTransaction[]

  @@index([restaurantId, category])
  @@map("ingredients")
}

model Recipe {
  id         String @id @default(uuid()) @db.Uuid
  menuItemId String @unique @map("menu_item_id") @db.Uuid

  menuItem           MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  recipeIngredients  RecipeIngredient[]

  @@map("recipes")
}

model RecipeIngredient {
  id               String  @id @default(uuid()) @db.Uuid
  recipeId         String  @map("recipe_id") @db.Uuid
  ingredientId     String  @map("ingredient_id") @db.Uuid
  quantityRequired Decimal @map("quantity_required") @db.Decimal(10, 3)

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@map("recipe_ingredients")
}

model Order {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  tableId      String?     @map("table_id") @db.Uuid
  serverId     String      @map("server_id") @db.Uuid
  orderNumber  Int         @default(autoincrement()) @unique @map("order_number")
  status       OrderStatus @default(open)
  subtotal     Decimal     @default(0) @db.Decimal(10, 2)
  tax          Decimal     @default(0) @db.Decimal(10, 2)
  tip          Decimal     @default(0) @db.Decimal(10, 2)
  total        Decimal     @default(0) @db.Decimal(10, 2)
  paymentMethod String?    @map("payment_method") @db.VarChar(20)
  cardBrand    String?     @map("card_brand") @db.VarChar(20)
  allergyNotes String?     @map("allergy_notes")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  closedAt     DateTime?   @map("closed_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  server     Staff      @relation(fields: [serverId], references: [id])
  items      OrderItem[]
  stockTransactions StockTransaction[]

  @@index([restaurantId, status, createdAt])
  @@map("orders")
}

model OrderItem {
  id           String      @id @default(uuid()) @db.Uuid
  orderId      String      @map("order_id") @db.Uuid
  menuItemId   String      @map("menu_item_id") @db.Uuid
  quantity     Int         @default(1)
  unitPrice    Decimal     @map("unit_price") @db.Decimal(10, 2)
  modifiers    Json        @default("[]")
  prepStatus   String      @default("firing") @map("prep_status") @db.VarChar(50)
  station      KdsStation
  course       String      @default("main") @db.VarChar(20)
  seat         String?     @db.VarChar(20)
  notes        String?     @db.VarChar(500)
  bumpedAt     DateTime?   @map("bumped_at") @db.Timestamptz
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([station, prepStatus])
  @@index([orderId])
  @@map("order_items")
}

model StockTransaction {
  id              String         @id @default(uuid()) @db.Uuid
  restaurantId    String         @map("restaurant_id") @db.Uuid
  ingredientId    String         @map("ingredient_id") @db.Uuid
  quantityChange  Decimal        @map("quantity_change") @db.Decimal(12, 3)
  reason          StockTxReason
  referenceOrderId String?       @map("reference_order_id") @db.Uuid
  note            String?        @db.VarChar(500)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [referenceOrderId], references: [id], onDelete: SetNull)

  @@index([ingredientId, createdAt])
  @@index([restaurantId, createdAt])
  @@map("stock_transactions")
}

model StaffShift {
  id             String    @id @default(uuid()) @db.Uuid
  restaurantId   String    @map("restaurant_id") @db.Uuid
  staffId        String?   @map("staff_id") @db.Uuid
  userName       String    @map("user_name") @db.VarChar(100)
  role           UserRole
  hourlyRate     Decimal   @map("hourly_rate") @db.Decimal(10, 2)
  station        String?   @db.VarChar(100)
  scheduledStart DateTime  @map("scheduled_start") @db.Timestamptz
  scheduledEnd   DateTime  @map("scheduled_end") @db.Timestamptz
  clockIn        DateTime? @map("clock_in") @db.Timestamptz
  clockOut       DateTime? @map("clock_out") @db.Timestamptz
  status         String    @default("scheduled") @db.VarChar(50)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  staff      Staff?     @relation(fields: [staffId], references: [id], onDelete: SetNull)
  signoffs   BriefingSignoff[]

  @@index([restaurantId, clockIn])
  @@map("staff_shifts")
}

model BriefingSignoff {
  id                   String   @id @default(uuid()) @db.Uuid
  restaurantId         String   @map("restaurant_id") @db.Uuid
  shiftId              String   @map("shift_id") @db.Uuid
  staffName            String   @map("staff_name") @db.VarChar(100)
  allergenAcknowledged Boolean  @default(true) @map("allergen_acknowledged")
  haccpAcknowledged    Boolean  @default(true) @map("haccp_acknowledged")
  signedAt             DateTime @default(now()) @map("signed_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  shift      StaffShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([shiftId])
  @@map("briefing_signoffs")
}

model KnowledgeBase {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  category     String   @db.VarChar(100)
  title        String   @db.VarChar(255)
  content      String
  embedding    Json?
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("knowledge_base")
}

model CallLog {
  id              String      @id @default(uuid()) @db.Uuid
  restaurantId    String      @map("restaurant_id") @db.Uuid
  callerPhone     String      @map("caller_phone") @db.VarChar(50)
  callerName      String?     @map("caller_name") @db.VarChar(100)
  durationSeconds Int         @map("duration_seconds")
  summary         String?
  transcript      String?
  outcome         CallOutcome
  reservationId   String?     @map("reservation_id") @db.Uuid
  sentimentScore  Decimal?    @map("sentiment_score") @db.Decimal(3, 2)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@map("call_logs")
}

model Reservation {
  id              String   @id @default(uuid()) @db.Uuid
  restaurantId    String   @map("restaurant_id") @db.Uuid
  guestName       String   @map("guest_name") @db.VarChar(100)
  phone           String   @db.VarChar(40)
  email           String?  @db.VarChar(255)
  partySize       Int      @map("party_size")
  reservationTime DateTime @map("reservation_time") @db.Timestamptz
  tableId         String?  @map("table_id") @db.Uuid
  status          String   @default("confirmed") @db.VarChar(30)
  source          String   @default("host") @db.VarChar(30)
  notes           String?
  vip             Boolean  @default(false)
  occasion        String?  @db.VarChar(120)
  serverId        String?  @map("server_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  server     Staff?       @relation(fields: [serverId], references: [id], onDelete: SetNull)

  @@index([restaurantId, reservationTime])
  @@map("reservations")
}

model Trainee {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  fullName     String   @map("full_name") @db.VarChar(100)
  role         String   @db.VarChar(100)
  mentor       String?  @db.VarChar(100)
  status       String   @default("in_training") @db.VarChar(30)
  progress     Int      @default(0)
  badges       String[] @default([])
  magicLink    String?  @map("magic_link") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  restaurant  Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  assignments TrainingAssignment[]

  @@map("trainees")
}

model TrainingModule {
  id           String  @id @default(uuid()) @db.Uuid
  restaurantId String  @map("restaurant_id") @db.Uuid
  title        String  @db.VarChar(255)
  track        String  @db.VarChar(100)
  description  String?
  durationMinutes Int  @default(15) @map("duration_minutes")
  displayOrder Int     @default(0) @map("display_order")

  restaurant  Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  assignments TrainingAssignment[]

  @@map("training_modules")
}

model TrainingAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  traineeId String   @map("trainee_id") @db.Uuid
  moduleId  String   @map("module_id") @db.Uuid
  status    String   @default("not_started") @db.VarChar(30)
  score     Int?
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  trainee Trainee        @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  module  TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([traineeId, moduleId])
  @@map("training_assignments")
}

model Notification {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  channel      String   @db.VarChar(30)
  recipients   String[] @default([])
  message      String
  status       String   @default("queued") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
