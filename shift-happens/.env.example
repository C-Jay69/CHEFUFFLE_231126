# ---------------------------------------------------------------------------
# SHIFT HAPPENS! environment configuration
# Copy to .env and adjust. Everything has a safe local default.
# ---------------------------------------------------------------------------

# PostgreSQL (local dev cluster started by `pnpm db:up`)
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/shift_happens?schema=public"

# Redis is optional. When present it powers the Socket.io adapter + 86 cache.
# Leave empty to use the in-process pub/sub fallback.
REDIS_URL=""

# API server
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
WEB_ORIGIN="http://localhost:3000"

# Frontend uses the API origin directly for REST + WebSockets.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Default tenant
RESTAURANT_ID="11111111-1111-4111-8111-111111111111"

# Twilio Voice (optional — webhook works without credentials)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_SMS_FROM=""

# Gemini / Google AI (optional — deterministic RAG fallback is used without it)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_EMBED_MODEL="text-embedding-004"

# SendGrid (optional — SMS/email notifications are logged when unset)
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="ops@shifthappens.local"

# Stripe (optional — split-check UI falls back to simulated capture)
STRIPE_SECRET_KEY=""
